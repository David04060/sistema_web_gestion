{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "test": "node --test tests/contracts.test.mjs tests/session.test.mjs tests/routes.test.mjs tests/pdf.test.mjs tests/documental.test.mjs tests/detalle-documental.test.mjs tests/tema.test.mjs tests/dashboard-graficos.test.mjs",
    "analyze:bundle": "node scripts/analizar-bundle.mjs",
    "build:clasificacion:dev": "tsc -b && node scripts/build-clasificacion-dev.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
