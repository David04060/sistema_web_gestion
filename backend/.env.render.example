# Referencia para variables del servicio Render. No subir un archivo con valores reales.
NODE_ENV=production
NODE_VERSION=24.21.0
DB_PROFILE=neon
TRUST_PROXY_HOPS=1
DATABASE_URL=postgresql://sistema_web_app:CONTRASENA_CODIFICADA@ep-ENDPOINT_PRODUCTION.REGION.aws.neon.tech/sistema_documental_produccion?sslmode=verify-full
JWT_SECRET=REEMPLAZAR_POR_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
NEON_BRANCH_ID=br-REEMPLAZAR_POR_BRANCH_ID_PRODUCTION
NEON_HOST=ep-ENDPOINT_PRODUCTION.REGION.aws.neon.tech
NEON_DATABASE=sistema_documental_produccion
CORS_ORIGINS=https://REEMPLAZAR_POR_ORIGEN_PAGES
# Completar para habilitar los PDF; el bucket debe ser privado.
R2_PDF_ACCOUNT_ID=REEMPLAZAR_POR_ID_CUENTA
R2_PDF_BUCKET=REEMPLAZAR_POR_BUCKET_PDF
R2_PDF_ACCESS_KEY_ID=REEMPLAZAR_POR_ACCESS_KEY
R2_PDF_SECRET_ACCESS_KEY=REEMPLAZAR_POR_SECRET_KEY
R2_PDF_PREFIX=produccion/
# Render suministra RENDER=true y PORT. No copiar el PORT del entorno local.
