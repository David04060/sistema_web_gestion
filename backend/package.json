{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev:neon": "tsx watch src/server.ts --neon",
    "start:neon": "node dist/server.js --neon",
    "check:neon": "node scripts/verificar-conexion.mjs --neon",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check:db": "npm run build && node scripts/verificar-db.mjs",
    "test:admin": "npm run build && node --test tests/admin.integration.mjs",
    "test:catalogos": "npm run build && node --test tests/catalogos.integration.mjs",
    "test:documentos-consultas": "npm run build && node --test tests/documentos.consultas.integration.mjs",
    "test:migracion-documental": "npm run build && node --test tests/flujo-migration.integration.mjs",
    "test:siseve": "npm run test:migracion-documental",
    "test:dashboard": "npm run build && node --test tests/dashboard.integration.mjs",
    "test:revision-final": "npm run build && node --test tests/revision-final.integration.mjs",
    "test:archivos": "node --import tsx --test tests/archivos.integration.mjs",
    "dev:neon:qa": "tsx watch src/server.ts --neon-qa",
    "start:neon:qa": "node dist/server.js --neon-qa",
    "check:neon:qa": "node scripts/verificar-neon-qa.mjs",
    "test:neon:qa:documental": "node scripts/probar-neon-qa.mjs flujo-migration.integration.mjs",
    "test:neon:qa:dashboard": "node scripts/probar-neon-qa.mjs dashboard.integration.mjs",
    "test:ciclo-ingresos": "node --import tsx --test tests/ciclo-ingresos.integration.mjs",
    "test:continuidad": "node --import tsx --test tests/continuidad.integration.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": "24.x"
  }
}
