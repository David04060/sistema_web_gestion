    "test:documental": "npm run build && node --test tests/documental-nuevo.test.mjs",
    "test:mejoras:local": "npm run build && node --test tests/mejoras-local.test.mjs",
    "test:revision:local": "npm run build && node --test tests/revision-integral-local.test.mjs tests/administracion-local.test.mjs tests/mejoras-local.test.mjs tests/delegacion-local.test.mjs",
    "schema:documentar": "node scripts/documentar-base-documental.mjs",
    "hash:local": "npm run build && node scripts/generar-hash-local.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
