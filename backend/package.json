  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run build && node scripts/probar-backend-aislado.mjs completa",
    "test:documental": "npm run build && node scripts/probar-backend-aislado.mjs documental",
    "test:mejoras:local": "npm run build && node scripts/probar-backend-aislado.mjs mejoras",
    "test:revision:local": "npm run build && node scripts/probar-backend-aislado.mjs revision",
    "test:unitarias:heredadas": "npm run build && node scripts/probar-backend-aislado.mjs unitarias-heredadas",
    "test:guard": "node --test tests/entorno-prueba.test.mjs",
    "schema:documentar": "node scripts/documentar-base-documental.mjs",
    "hash:local": "npm run build && node scripts/generar-hash-local.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
