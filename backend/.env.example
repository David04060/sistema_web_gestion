# Copiar como .env y sustituir los marcadores; nunca guardar credenciales en Git.
NODE_ENV=development
DB_PROFILE=local
PORT=3000
DATABASE_URL=postgresql://postgres:CONTRASENA_CODIFICADA@localhost:5432/sistema_web_documental_final
JWT_SECRET=REEMPLAZAR_POR_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
CORS_ORIGINS=
TRUST_PROXY_HOPS=0
# Opcionales: habilitan PDF con un bucket privado independiente de respaldos.
# R2_PDF_ACCOUNT_ID=
# R2_PDF_BUCKET=
# R2_PDF_ACCESS_KEY_ID=
# R2_PDF_SECRET_ACCESS_KEY=
# R2_PDF_PREFIX=desarrollo/
